  "claims": [
    {
      "text": "Sensor airbag mengukur tingkat keparahan tabrakan sejak tabrakan dimulai; bila cukup parah, sensor memicu inflator yang mengisi kantong dengan gas. Sumber: IIHS, Airbags (iihs.org/topics/airbags).",
      "reviewed": false
    },
    {
      "text": "Airbag samping umumnya mengembang dalam 10-20 milidetik pertama tabrakan samping; airbag depan mengembang dalam sepersekian detik. Sumber: IIHS, Airbags.",
      "reviewed": false
    },
    {
      "text": "Satu kedipan mata berlangsung sekitar 100-400 milidetik. Sumber: BioNumbers (Harvard), durasi kedipan mata.",
      "reviewed": false
    },
    {
      "text": "NHTSA memperkirakan airbag depan telah menyelamatkan 70.059 nyawa di AS sampai 2019. Sumber: IIHS mengutip NHTSA.",
      "reviewed": false
    },
    {
      "text": "Airbag + sabuk pengaman (lap & shoulder) menurunkan risiko kematian pada tabrakan depan 61%, dibanding 50% sabuk saja dan 34% airbag saja. Sumber: IIHS mengutip NHTSA.",
      "reviewed": false
    },
    {
      "text": "Pengemudi sebaiknya menjaga dada minimal 10 inci (sekitar 25 cm) dari tengah setir; anak kecil duduk di kursi belakang. Sumber: IIHS, Airbags.",
      "reviewed": false
    }
  ],
