  "handle": "@doktermobil",
  "claims": [
    {
      "text": "Brake fade terjadi ketika cakram dan kampas terlalu panas karena pengereman terus menerus; gaya gesek (cengkeraman) menurun sehingga pedal terasa dalam.",
      "reviewed": false
    },
    {
      "text": "Cakram rem bisa membara (memerah) pada pengereman berat berulang; warna memerah menandakan suhu permukaan yang sangat tinggi.",
      "reviewed": false
    },
    {
      "text": "Kampas rem yang terlalu panas dapat mengeras/mengkilap (glazing) sehingga gesekannya turun dan tidak lagi menggigit.",
      "reviewed": false
    },
    {
      "text": "Engine brake (menurunkan gigi) membantu memperlambat tanpa memanaskan rem secara berlebihan pada turunan panjang.",
      "reviewed": false
    }
  ],
